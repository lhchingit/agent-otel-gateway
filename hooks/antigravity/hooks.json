{
  "agy-otel": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\<you>\\.local\\opt\\agy-otel\\agy-otel-hook.cmd PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "C:\\Users\\<you>\\.local\\opt\\agy-otel\\agy-otel-hook.cmd PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "C:\\Users\\<you>\\.local\\opt\\agy-otel\\agy-otel-hook.cmd Stop",
        "timeout": 10
      }
    ]
  }
}
