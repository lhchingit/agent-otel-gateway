{
  "agy-otel": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\<you>\\.local\\opt\\agy-otel\\Scripts\\python.exe\" \"C:\\Users\\<you>\\.local\\opt\\agy-otel\\hook.py\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "\"C:\\Users\\<you>\\.local\\opt\\agy-otel\\Scripts\\python.exe\" \"C:\\Users\\<you>\\.local\\opt\\agy-otel\\hook.py\" PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"C:\\Users\\<you>\\.local\\opt\\agy-otel\\Scripts\\python.exe\" \"C:\\Users\\<you>\\.local\\opt\\agy-otel\\hook.py\" Stop",
        "timeout": 10
      }
    ]
  }
}
